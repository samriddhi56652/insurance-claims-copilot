# Copy this file to `.env` and fill in your keys.
#   PowerShell:  Copy-Item .env.example .env
#   bash / sh:   cp .env.example .env
# `.env` is gitignored - never commit real keys.

# --- REQUIRED --------------------------------------------------------------
# Groq Cloud - the LLM that writes every draft / coverage recommendation.
# Without this, the copilot fails to start and draft endpoints return 503.
# Get one (free, no card): https://console.groq.com  ->  API Keys  ->  Create API Key
# Format: gsk_...
GROQ_API_KEY=

# --- OPTIONAL, but recommended -------------------------------------------------
# Google Gemini - embeddings for the RAG knowledge base and semantic customer memory.
# If omitted:
#   * RAG falls back to Chroma's built-in local embeddings (works, lower quality)
#   * Customer memory falls back to recency-only (no semantic search)
# Get one (free): https://aistudio.google.com/apikey  ->  Create API key
# Format: AIza...
GOOGLE_API_KEY=

# --- OPTIONAL tuning (defaults shown) ----------------------------------------
# GROQ_MODEL=openai/gpt-oss-20b       # any chat model your Groq account can use
# LLM_TEMPERATURE=0.2
# GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
# API_HOST=0.0.0.0
# API_PORT=8000

# For the Streamlit dashboard (app.py) when the API is not on localhost:8000.
# docker-compose.yml already sets this to http://api:8000 for the container.
# API_BASE_URL=http://localhost:8000

# NOTE: settings.py also defines OPENAI_API_KEY and ENABLE_LOCAL_EMBEDDINGS,
# but nothing in the current code uses them. Leave them unset.
